{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "dashboard.py", "--server.headless", "true", "--server.port", "8501", "--browser.gatherUsageStats", "false"],
      "port": 8501
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": ".venv/Scripts/python.exe",
